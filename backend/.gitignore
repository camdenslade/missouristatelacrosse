# ==============================
# Sensitive Configs
# ==============================
# The base config (application.properties), the test config
# (application-test.properties), and the Docker/local-dev profile
# (application-local.properties) hold no secrets - every value is ${ENV_VAR:default} or
# an obvious fake - so they ARE tracked. Only ignore prod/secret override profiles that
# would carry real values.
application-prod.properties
application-prod.yml
application-secret*.properties
application-secret*.yml
.env
.env.*


# AWS credentials (if ever used)
.aws/
.aws/credentials
aws-credentials.json

# ==============================
# OS / Misc
# ==============================
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak

# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml
