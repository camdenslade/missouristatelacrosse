# Copy to `.env` for local frontend development (`npm run dev`).
# Everything here ships in the browser bundle - no real secrets belong in this file.
# The real production values live in the maintainer's own `.env` (git-ignored).

# Where the SPA sends API calls. Local backend (docker compose / bootRun) is :8080.
VITE_API_BASE=http://localhost:8080

# Payment rail per program: "paypal" (default) or "stripe". See docs/payments.md.
VITE_PAYMENT_PROVIDER=paypal
VITE_PAYMENT_PROVIDER_WOMEN=paypal

# Public PayPal client id (from the PayPal app). Leave blank locally unless testing pay.
VITE_PAYPAL_CLIENT_ID=

# Public Stripe publishable key (pk_test_... locally). Blank unless testing Stripe.
VITE_STRIPE_PUBLISHABLE_KEY=

# Feature toggles - show/hide the store and donations per program.
VITE_TEAMSTORE_ENABLED=true
VITE_TEAMSTORE_ENABLED_WOMEN=true
VITE_DONATE_ENABLED=true
VITE_DONATE_ENABLED_WOMEN=true
